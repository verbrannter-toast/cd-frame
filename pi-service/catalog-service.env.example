# Copy to /etc/catalog-service.env, fill in, then: sudo chmod 600 /etc/catalog-service.env

# Contact address for MusicBrainz (required by their usage policy)
CATALOG_USER_AGENT=CDFrameCatalog/1.0 (you@example.com)

# Home Assistant (host-mapped port; works with network_mode: host)
HA_URL=http://localhost:8123
# Profile -> Security -> Long-Lived Access Tokens -> Create Token
HA_TOKEN=paste-your-long-lived-token-here
HA_ENTITY=input_select.loaded_album

# Host path of <HA config dir>/www/albums (must be inside the folder mounted into the HA container)
WWW_ALBUMS_DIR=/home/youruser/homeassistant/config/www/albums
